#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define QWERTY_L 0
#define DVORAK_L 1
#define COLEMK_L 2
#define NAV_L    3
#define SYM_L    4
#define ADJ_L    5
#define Undo   LC(Z)
#define Cut    LC(X)
#define Copy   LC(C)
#define Paste  LC(V)
#define Redo   LC(Y)

&mt {
    tapping-term-ms = <190>;
    flavor = "tap-preferred";
};

&lt { tapping-term-ms = <190>; };

/ {
    macros {
        mp: mp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp M &kp A &kp S &kp T &kp E &kp R &kp LS(C) &kp H &kp LS(I) &kp E &kp LS(F) &kp AMPS &kp M &kp J &kp O &kp L &kp N &kp I &kp R &kp M &kp A &kp R &kp K &kp N5 &kp I &kp V &kp E &kp EXCL>;
            label = "MP";
        };

        gp: gp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(M) &kp J &kp O &kp L &kp N &kp I &kp R &kp M &kp A &kp R &kp K &kp N5 &kp I &kp V &kp E>;
            label = "GP";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* QWERTY
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | `     |   Q   |   W   |   E   |   R   |   T   |-----------------------------------|   Y   |   U   |   I   |   O   |   P   | BKSPC |
 * | TAB   |   A   |   S   |   D   |   F   |   G   |-----------------------------------|   H   |   J   |   K   |   L   |   ;   | ENTER |
 * | CTRL  |   Z   |   X   |   C   |   V   |   B   |  ESC  |-------------------|  CAPS |   N   |   M   |   ,   |   .   |   /   |   '   |
 *                                 |  GUI  |  ALT  |SK SHFT|  Nav  |---|  Sym  | SPACE |  ALT  |  GUI  |
 */

            bindings = <
&mo 6       &kp Q                       &kp W           &kp F        &kp P           &kp B                                           &kp J  &kp L                     &kp U        &kp Y           &kp SEMI           &mo 6
&bl BL_DEC  &mt LS(LA(LC(LEFT_GUI))) A  &mt LEFT_ALT R  &mt LCTRL S  &mt LEFT_GUI T  &kp G                                           &kp M  &mt LEFT_GUI N            &mt LCTRL E  &mt LEFT_ALT I  &mt RIGHT_SHIFT O  &bl BL_INC
&kp LC(B)   &kp Z                       &kp X           &kp C        &kp D           &kp V  &mp                           &gp        &kp K  &kp H                     &kp COMMA    &kp DOT         &kp SLASH          &kp LC(B)
                                                                     &mo 5           &mo 4  &mo 3  &kp LEFT_SHIFT  &mo 2  &kp SPACE  &mo 1  &kp LS(LA(LC(LEFT_GUI)))
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            /* NAV
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | Copy  |   1   |   2   |   3   |   4   |   5   |-----------------------------------|   6   |   7   |   8   |   9   |   0   | BSPC  |
 * | Cut   |  GUI  |  Alt  | Ctrl  | Shift | Paste |-----------------------------------| PG UP |  Left |  Up   |  Down | Right | PG DN |
 * | Ctrl  |  F1   |  F2   |  F3   |  F4   |  F5   |  UnDo |-------------------| ReDo  |  F6   |  F7   |  F8   |  F9   |  F10  | Ctrl  |
 *                                 |       |       |       |       |---| ADJ_L |       |       |       |
 */

            bindings = <
&trans  &trans          &trans       &trans             &trans         &trans                                       &kp HOME         &kp LC(LS(TAB))  &kp UP       &kp LC(TAB)  &kp END          &trans
&trans  &kp ESC         &kp TAB      &kp BSPC           &kp RET        &kp Paste                                    &kp LC(PERCENT)  &kp LEFT         &kp DOWN     &kp RIGHT    &kp LG(PERCENT)  &trans
&trans  &kp LS(ESCAPE)  &kp LS(TAB)  &kp LA(BACKSPACE)  &kp LS(ENTER)  &trans     &trans                  &kp Redo  &kp PAGE_UP      &kp CARET        &kp PERCENT  &kp DOLLAR   &kp PAGE_DOWN    &kp RCTRL
                                                        &trans         &trans     &trans  &trans  &trans  &trans    &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            /* SYM
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | INS   |   !   |   @   |   #   |   $   |   %   |-----------------------------------|   ^   |   &   |   *   |   (   |   )   | BSPC  |
 * |       |   \   |   -   |   =   |   [   |   ]   |-----------------------------------| HOME  | Shift | Ctrl  | Alt   | Gui   | END   |
 * | Ctrl  |   |   |   _   |   +   |   {   |   }   |SkAltGr|-------------------| MENU  | Mute  | Vol-  | Vol+  | Play  |       | Ctrl  |
 *                                 |       |       |       |  ADJ_L |---|      |       |       |       |
 */

            bindings = <
&trans  &kp GRAVE        &kp LESS_THAN  &kp GREATER_THAN  &kp CARET      &kp UNDER                                  &kp AMPERSAND      &kp SEMICOLON  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SLASH     &trans
&trans  &kp EXCLAMATION  &kp MINUS      &kp PLUS          &kp EQUAL      &kp HASH                                   &kp AT_SIGN        &kp COLON      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION  &trans
&trans  &kp TILDE        &kp DOLLAR     &kp ASTERISK      &kp BACKSLASH  &kp PIPE   &trans                  &trans  &kp DOUBLE_QUOTES  &kp PERCENT    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp SQT       &trans
                                                          &trans         &trans     &trans  &trans  &trans  &trans  &trans             &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        core_layer {
            /* ADJUST
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |       | QWERTY| DVORAK| COLEMK|       |       |-----------------------------------|       |  F11  |  F12  |Prt Scr|EP_OFF | EP_ON |
 * | RESET | BT 0  | BT 1  | BT 2  | BT 3  | BT 4  |-----------------------------------|       |       |       |       |       | RESET |
 * |       | LGUI  | LALT  | LCTRL | LSHIFT|       |BT CLR |-------------------|       |       |       |OUT_USB|OUT_BLE|       | BOOTL |
 *                                 |       |       |       |       |---|       |       |       |       |
 */

            bindings = <
&trans  &kp N1          &kp N2       &kp N3        &kp N4       &kp N5                                  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &none
&trans  &kp ESC         &kp TAB      &kp BSPC      &kp RET      &trans                                  &none   &kp N4  &kp N5  &kp N6  &none   &none
&trans  &kp LS(ESCAPE)  &kp LS(TAB)  &kp LA(BSPC)  &kp LS(RET)  &trans  &trans                  &trans  &none   &kp N1  &kp N2  &kp N3  &none   &none
                                                   &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        window_nav {
            bindings = <
&trans  &trans          &trans              &kp LG(UP_ARROW)    &trans         &trans                                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_SHIFT  &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT)  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LG(Z)       &kp LG(X)           &kp LG(C)           &kp LG(D)      &kp LG(V)  &trans                  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                                &trans         &trans     &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        column_nav {
            bindings = <
&trans  &trans  &trans                      &kp LC(LS(LG(UP_ARROW)))    &trans                 &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LS(LC(LG(LEFT_ARROW)))  &kp LC(LS(LG(DOWN_ARROW)))  &kp LS(LC(LG(RIGHT)))  &trans                                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans                      &trans                      &trans                 &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                                        &trans                 &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        system_layer {
            bindings = <
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans                                  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL
&sys_reset      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans                                  &trans  &trans  &trans  &trans  &trans  &sys_reset
&bootloader     &trans        &trans        &trans        &trans        &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans  &bootloader
                                                          &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
